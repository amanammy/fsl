@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tbox: <http://www.softlang.org/ontologies/tbox#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.softlang.org/ontologies/fsl> a owl:Ontology ;
    tbox:commentingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:formattingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:linkingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    tbox:metamodelingPolicy "See http://www.softlang.org/ontologies/tbox -- the same policy applies here."@en ;
    rdfs:comment "Ontology on the foundations of software languages"@en ;
    owl:versionIRI <http://www.softlang.org/ontologies/fsl/v1.0.0> ;
    owl:versionInfo "v1.0.0" ;
    dcterms:title "Foundations of Software Languages Ontology"@en ;
    dcterms:description "An ontology capturing foundational knowledge about software languages."@en ;
    dcterms:creator [ a schema:Person ; schema:givenName "Ralf" ; schema:familyName "Lämmel" ; schema:affiliation [ a schema:Organization ; schema:name "University of Koblenz" ] ] ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "fsl" ;
    vann:preferredNamespaceUri "http://www.softlang.org/ontologies/fsl#" ;
    owl:imports <http://www.softlang.org/ontologies/ae>,
        <http://www.softlang.org/ontologies/ce>,
        <http://www.softlang.org/ontologies/fe>,
        <http://www.softlang.org/ontologies/ie>,
        <http://www.softlang.org/ontologies/le>,
        <http://www.softlang.org/ontologies/pe>,
        <http://www.softlang.org/ontologies/te> .
